{
  "color": {
    "$description": "Near-black workspace with opaque slate surfaces and a single yellow accent for primary actions, keyboard focus and selection indicators. Pink is reserved for error states. Values reference primitives only.",
    "action": {
      "primary": { "$value": "{color.yellow.500}", "$type": "color" },
      "primary-hover": { "$value": "{color.yellow.400}", "$type": "color" },
      "secondary": { "$value": "{color.slate.850}", "$type": "color" },
      "secondary-hover": { "$value": "{color.slate.800}", "$type": "color" },
      "secondary-active": { "$value": "{color.slate.700}", "$type": "color" },
      "ghost": { "$value": "{color.transparent}", "$type": "color" },
      "ghost-hover": { "$value": "{color.slate.800}", "$type": "color" }
    },
    "text": {
      "default": { "$value": "{color.white}", "$type": "color" },
      "secondary": { "$value": "{color.slate.300}", "$type": "color" },
      "on-action": { "$value": "{color.slate.900}", "$type": "color" }
    },
    "surface": {
      "page": { "$value": "{color.slate.990}", "$type": "color" },
      "soft": { "$value": "{color.slate.975}", "$type": "color" },
      "muted": { "$value": "{color.slate.950}", "$type": "color" },
      "selection": { "$value": "{color.slate.950}", "$type": "color" },
      "accent-subtle": { "$value": "{color.yellow.900}", "$type": "color" },
      "field": { "$value": "{color.black}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.slate.700}", "$type": "color" },
      "control": { "$value": "{color.slate.500}", "$type": "color" },
      "hover": { "$value": "{color.slate.300}", "$type": "color" },
      "danger": { "$value": "{color.pink.500}", "$type": "color" }
    },
    "focus": {
      "ring": { "$value": "{color.yellow.500}", "$type": "color" }
    },
    "selection": {
      "indicator": { "$value": "{color.yellow.500}", "$type": "color" }
    },
    "status": {
      "danger": { "$value": "{color.pink.400}", "$type": "color" }
    },
    "waveform": {
      "default": { "$value": "{color.slate.300}", "$type": "color" }
    },
    "backdrop": {
      "inspector": { "$value": "{color.black-alpha.35}", "$type": "color" },
      "dialog": { "$value": "{color.black-alpha.48}", "$type": "color" }
    }
  }
}
