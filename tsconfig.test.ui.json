{
  "extends": "./tsconfig.web.json",
  "include": ["src/renderer/src/env.d.ts", "src/renderer/**/*.test.tsx", "src/preload/*.d.ts", "tests/support/ui/**/*.ts", "tests/support/fixtures/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom"]
  }
}
