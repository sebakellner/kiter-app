{
  "extends": "./tsconfig.web.json",
  "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.tsx", "src/shared/**/*.ts", "src/preload/*.d.ts", "tests/support/ui/**/*.ts", "tests/support/ui/**/*.tsx", "tests/support/fixtures/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tests-ui.tsbuildinfo",
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom"]
  }
}
